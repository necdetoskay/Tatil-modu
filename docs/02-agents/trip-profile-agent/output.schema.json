{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/trip-profile-agent/output.schema.json",
  "title": "Trip Profile Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agent",
    "requestId",
    "status",
    "tripProfileId",
    "origin",
    "destination",
    "travelParty",
    "dates",
    "transportation",
    "budget",
    "preferences",
    "familyConstraints",
    "specialRequirements",
    "missingInformation",
    "assumptions",
    "conflicts",
    "validationErrors",
    "clarificationPriority",
    "confidence",
    "confidenceFactors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "agent": {
      "type": "object"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "tripProfileId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "invalid"
      ]
    },
    "origin": {
      "type": "object"
    },
    "destination": {
      "type": "object"
    },
    "travelParty": {
      "type": "object"
    },
    "dates": {
      "type": "object"
    },
    "transportation": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "preferences": {
      "type": "object"
    },
    "familyConstraints": {
      "type": "object"
    },
    "specialRequirements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validationErrors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "clarificationPriority": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sourceTrace": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidenceFactors": {
      "type": "object",
      "required": [
        "inputCompleteness",
        "explicitInformationRatio",
        "conflictPenalty",
        "validationPenalty",
        "assumptionPenalty"
      ],
      "properties": {
        "inputCompleteness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "explicitInformationRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conflictPenalty": {
          "type": "number",
          "minimum": -1,
          "maximum": 0
        },
        "validationPenalty": {
          "type": "number",
          "minimum": -1,
          "maximum": 0
        },
        "assumptionPenalty": {
          "type": "number",
          "minimum": -1,
          "maximum": 0
        }
      }
    }
  }
}
