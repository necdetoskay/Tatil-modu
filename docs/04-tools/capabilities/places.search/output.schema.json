{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/capabilities/places.search/output.schema.json",
  "title": "places.search output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "results",
    "nextPageToken",
    "warnings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonicalPlaceId",
          "name",
          "categories",
          "coordinates",
          "address",
          "providerEntityIds",
          "operationalStatus",
          "rating",
          "reviewCount",
          "attributes",
          "sourceRefs"
        ],
        "properties": {
          "canonicalPlaceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coordinates": {
            "type": "object"
          },
          "address": {
            "type": [
              "object",
              "null"
            ]
          },
          "providerEntityIds": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1
          },
          "operationalStatus": {
            "type": "string",
            "enum": [
              "operational",
              "temporarily_closed",
              "permanently_closed",
              "unknown"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "reviewCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "attributes": {
            "type": "object"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "nextPageToken": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
