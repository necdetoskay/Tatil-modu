{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/tools/tool-observability-event.schema.json",
  "title": "Tool Observability Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "traceId",
    "spanId",
    "toolId",
    "capabilityId",
    "executionMode",
    "status"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string"
    },
    "spanId": {
      "type": "string"
    },
    "parentSpanId": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflowId": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "toolId": {
      "type": "string",
      "pattern": "^TL-[0-9]{3}$"
    },
    "capabilityId": {
      "type": "string"
    },
    "providerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "fixture",
        "hybrid",
        "live",
        "replay",
        "shadow"
      ]
    },
    "status": {
      "type": "string"
    },
    "latencyMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cacheHit": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "estimatedCost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "actualCost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "attemptCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fallbackUsed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sourceCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "warningCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "attributes": {
      "type": "object"
    }
  }
}
