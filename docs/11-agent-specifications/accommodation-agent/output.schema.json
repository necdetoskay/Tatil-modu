{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/accommodation-candidate-set.v1.json",
  "title": "AccommodationCandidateSet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "stayQuerySignature", "candidates", "rejectedCandidates", "warnings", "overallConfidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "stayQuerySignature": { "$ref": "#/$defs/stayQuerySignature" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "rejectedCandidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "stayQuerySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationName", "checkIn", "checkOut", "adults", "childrenAges", "rooms", "currency", "stayRole", "journeySegmentRef"],
      "properties": {
        "locationName": { "type": "string", "minLength": 1 },
        "checkIn": { "type": "string", "format": "date" },
        "checkOut": { "type": "string", "format": "date" },
        "adults": { "type": "integer", "minimum": 1 },
        "childrenAges": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 17 } },
        "rooms": { "type": "integer", "minimum": 1 },
        "currency": { "type": ["string", "null"] },
        "stayRole": { "enum": ["FINAL_DESTINATION", "OVERNIGHT_ONLY", "OVERNIGHT_AND_DAY", "MULTI_DAY"] },
        "journeySegmentRef": { "type": ["string", "null"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accommodationId", "providerIds", "name", "location", "availability", "priceQuote", "occupancyFit", "facilities", "policies", "eligibility", "familyFit", "reviewAnalysisRef", "evidence", "unresolvedClaims", "confidence"],
      "properties": {
        "accommodationId": { "type": "string", "minLength": 1 },
        "providerIds": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["provider", "id"], "properties": { "provider": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } } } },
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "object", "additionalProperties": false, "required": ["latitude", "longitude", "formattedAddress", "evidenceRefs"], "properties": { "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 }, "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }, "formattedAddress": { "type": ["string", "null"] }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } },
        "availability": { "type": "object", "additionalProperties": false, "required": ["status", "retrievedAt", "freshnessStatus", "querySignatureMatch", "evidenceRefs"], "properties": { "status": { "enum": ["LIVE_AVAILABLE", "LIVE_UNAVAILABLE", "UNKNOWN"] }, "retrievedAt": { "type": ["string", "null"], "format": "date-time" }, "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN"] }, "querySignatureMatch": { "type": "boolean" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } },
        "priceQuote": { "type": "object", "additionalProperties": false, "required": ["status", "totalAmount", "currency", "taxesFeesKnown", "retrievedAt", "freshnessStatus", "querySignatureMatch", "evidenceRefs"], "properties": { "status": { "enum": ["LIVE", "OFFICIAL", "ESTIMATED", "UNKNOWN"] }, "totalAmount": { "type": ["number", "null"], "minimum": 0 }, "currency": { "type": ["string", "null"] }, "taxesFeesKnown": { "type": ["boolean", "null"] }, "retrievedAt": { "type": ["string", "null"], "format": "date-time" }, "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN"] }, "querySignatureMatch": { "type": "boolean" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } },
        "occupancyFit": { "type": "object", "additionalProperties": false, "required": ["status", "roomsRequired", "childrenPolicyStatus", "evidenceRefs"], "properties": { "status": { "enum": ["SATISFIED", "VIOLATED", "UNVERIFIED"] }, "roomsRequired": { "type": ["integer", "null"], "minimum": 1 }, "childrenPolicyStatus": { "enum": ["SATISFIED", "VIOLATED", "UNVERIFIED", "NOT_APPLICABLE"] }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } },
        "facilities": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["key", "status", "evidenceRefs"], "properties": { "key": { "type": "string", "minLength": 1 }, "status": { "enum": ["PRESENT", "ABSENT", "UNKNOWN", "CONFLICTING"] }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } } },
        "policies": { "type": "object", "additionalProperties": false, "required": ["cancellation", "mealPlan", "checkInOut", "extraCharges"], "properties": { "cancellation": { "$ref": "#/$defs/policyFact" }, "mealPlan": { "$ref": "#/$defs/policyFact" }, "checkInOut": { "$ref": "#/$defs/policyFact" }, "extraCharges": { "$ref": "#/$defs/policyFact" } } },
        "eligibility": { "type": "object", "additionalProperties": false, "required": ["disposition", "dispositionReasons", "hardConstraintChecks"], "properties": { "disposition": { "enum": ["ACCEPTED", "REJECTED", "NEEDS_VERIFICATION"] }, "dispositionReasons": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "evidenceRefs"], "properties": { "code": { "type": "string", "minLength": 1 }, "constraintId": { "type": ["string", "null"] }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } } }, "hardConstraintChecks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["constraintId", "status", "evidenceRefs"], "properties": { "constraintId": { "type": "string", "minLength": 1 }, "status": { "enum": ["SATISFIED", "VIOLATED", "UNVERIFIED", "NOT_APPLICABLE"] }, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } } } } },
        "familyFit": { "type": "object", "additionalProperties": false, "required": ["band", "restFit", "locationFit", "reasonCodes"], "properties": { "band": { "enum": ["EXCELLENT", "GOOD", "CONDITIONAL", "WEAK", "UNKNOWN"] }, "restFit": { "enum": ["GOOD", "CONDITIONAL", "WEAK", "UNKNOWN"] }, "locationFit": { "enum": ["GOOD", "CONDITIONAL", "WEAK", "UNKNOWN"] }, "reasonCodes": { "type": "array", "items": { "type": "string" } } } },
        "reviewAnalysisRef": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "unresolvedClaims": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "policyFact": { "type": "object", "additionalProperties": false, "required": ["status", "value", "evidenceRefs"], "properties": { "status": { "enum": ["SUPPORTED", "PARTIAL", "CONFLICTING", "UNKNOWN"] }, "value": {}, "evidenceRefs": { "type": "array", "items": { "type": "string" } } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "claimType", "sourceTier", "sourceRef", "retrievedAt", "freshnessStatus"], "properties": { "evidenceId": { "type": "string", "minLength": 1 }, "claimType": { "type": "string", "minLength": 1 }, "sourceTier": { "type": "integer", "minimum": 1, "maximum": 4 }, "sourceRef": { "type": "string", "minLength": 1 }, "retrievedAt": { "type": "string", "format": "date-time" }, "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN"] } } }
  }
}
