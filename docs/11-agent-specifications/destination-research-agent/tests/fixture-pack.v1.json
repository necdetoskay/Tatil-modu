    {"id": "DR-AUTH-006", "attempt": "mark_hard_constraint_satisfied", "expected": "FAIL", "code": "AUTH_HARD_CONSTRAINT_SATISFIED_WITHOUT_VERIFICATION"},
    {"id": "DR-AUTH-007", "attempt": "exceptional_without_exception_ref", "expected": "FAIL", "code": "AUTH_EXCEPTION_WITHOUT_POLICY"}
