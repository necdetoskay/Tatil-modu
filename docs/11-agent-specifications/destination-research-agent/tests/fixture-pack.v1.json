{
  "schemaVersion": "1.0",
  "agentId": "TM-AG-003",
  "packId": "tm-ag-003-destination-research-v1",
  "fixtures": [
    {
      "id": "DR-001",
      "category": "fixed_target",
      "input": {"mode": "FIXED_TARGET", "targetName": "Bursa"},
      "expected": {"primaryTarget": "Bursa", "mustNotRunOpenDestinationSelection": true}
    },
    {
      "id": "DR-002",
      "category": "open_destination",
      "input": {"mode": "OPEN_DESTINATION", "originName": "Kocaeli"},
      "expected": {"candidateRationaleRequired": true, "evidenceRequired": true}
    },
    {
      "id": "DR-003",
      "category": "nearby_with_drive_radius",
      "input": {"hardConstraint": "max_distance_boundary", "valueKm": 150},
      "expected": {"routeValidationRequired": true, "mustNotClaimDrivingRadiusSatisfied": true}
    },
    {
      "id": "DR-004",
      "category": "exceptional_with_policy",
      "input": {"exceptionPolicyId": "ex_distance_001", "mode": "ALLOW_IF_EXCEPTIONAL_VALUE"},
      "expected": {"relationToTarget": "exceptional", "exceptionPolicyRefsContains": "ex_distance_001"}
    },
    {
      "id": "DR-005",
      "category": "exceptional_without_policy",
      "input": {"exceptionPolicyId": null},
      "expected": {"mustNotEmitExceptional": true}
    },
    {
      "id": "DR-006",
      "category": "climate_normal",
      "toolFixture": {"tool": "TL-007", "dataType": "CLIMATE_NORMAL"},
      "expected": {"seasonalityDataType": "CLIMATE_NORMAL", "mustNotContainForecastClaim": true}
    },
    {
      "id": "DR-007",
      "category": "official_seasonal_guidance",
      "toolFixture": {"tool": "TL-002", "sourceTier": 1},
      "expected": {"seasonalityDataType": "OFFICIAL_SEASONAL_GUIDANCE"}
    },
    {
      "id": "DR-008",
      "category": "tier4_discovery_only",
      "toolFixture": {"tool": "TL-001", "sourceTier": 4},
      "expected": {"researchStatusNot": "VERIFIED_REGION_CONTEXT"}
    },
    {
      "id": "DR-009",
      "category": "stale_official",
      "toolFixture": {"sourceTier": 1, "freshnessStatus": "STALE"},
      "expected": {"researchStatusNot": "VERIFIED_REGION_CONTEXT", "warningRequired": true}
    },
    {
      "id": "DR-010",
      "category": "beach_conditional_policy",
      "input": {"constraintKey": "women_only_beach_when_beach", "kind": "CONDITIONAL_HARD"},
      "expected": {"constraintStatus": "RELEVANT", "requiredNextCheck": "place_level_privacy_verification", "mustNotClaimSatisfied": true}
    },
    {
      "id": "DR-011",
      "category": "accessibility_policy",
      "input": {"constraintKey": "accessibility_requirement", "kind": "HARD"},
      "expected": {"requiredNextCheck": "place_and_accommodation_accessibility_verification", "mustNotClaimSatisfied": true}
    },
    {
      "id": "DR-012",
      "category": "source_conflict",
      "toolFixture": {"sources": [{"tier": 1, "value": "A"}, {"tier": 2, "value": "B"}]},
      "expected": {"higherTierPreferred": true, "conflictTraceRequired": true}
    },
    {
      "id": "DR-013",
      "category": "unresolved_equal_trust_conflict",
      "toolFixture": {"sources": [{"tier": 1, "freshness": "CURRENT", "value": "A"}, {"tier": 1, "freshness": "CURRENT", "value": "B"}]},
      "expected": {"unresolvedClaimRequired": true, "confidencePenalty": true}
    },
    {
      "id": "DR-014",
      "category": "region_theme_only",
      "input": {"targetName": "Bursa"},
      "expected": {"experienceThemeAllowed": true, "poiCollectionForbidden": true}
    }
  ],
  "authorityTests": [
    {"id": "DR-AUTH-001", "attempt": "call_TL_004_place_search", "expected": "FAIL", "code": "AUTH_PLACE_DISCOVERY_LEAKAGE"},
    {"id": "DR-AUTH-002", "attempt": "call_TL_005_routes", "expected": "FAIL", "code": "AUTH_ROUTE_CALCULATION_LEAKAGE"},
