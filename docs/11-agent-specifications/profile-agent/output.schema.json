{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/traveler-profile.v1.json",
  "title": "TravelerProfile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "party", "tripContext", "transport", "unknownFields", "conflicts", "evidence", "overallConfidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adults", "children", "totalTravelers"],
      "properties": {
        "adults": { "type": ["integer", "null"], "minimum": 0 },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ageYears", "evidenceRefs"],
            "properties": {
              "ageYears": { "type": ["integer", "null"], "minimum": 0, "maximum": 17 },
              "evidenceRefs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "totalTravelers": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "tripContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "destination"],
      "properties": {
        "origin": { "$ref": "#/$defs/sourcedNullableString" },
        "destination": { "$ref": "#/$defs/sourcedNullableString" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "evidenceRefs"],
      "properties": {
        "mode": { "enum": ["own_car", "public_transport", "flight", "unknown"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unknownFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "fieldPaths", "evidenceRefs"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "fieldPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "type", "fieldPath", "sourceRef"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "type": { "enum": ["USER_EXPLICIT", "CONVERSATION_FACT", "MEMORY_DISCLOSURE", "NORMALIZATION"] },
          "fieldPath": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 },
          "excerpt": { "type": ["string", "null"] }
        }
      }
    },
    "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "sourcedNullableString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidenceRefs"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
