{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/official-fact.v1.json",
  "title": "OfficialFact.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "officialFactId", "requestId", "claimRef", "subjectRef", "claimType", "authorityPolicySnapshotId", "sourcePolicySnapshotId", "status", "resolvedValue", "verificationScope", "sourceLookupPath", "sourceLookupTrace", "sourceRegistryRefs", "primarySourceRefs", "evidence", "conflicts", "sourceFeedback", "freshnessStatus", "confidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "officialFactId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "claimRef": { "type": "string", "minLength": 1 },
    "subjectRef": { "type": "string", "minLength": 1 },
    "claimType": { "type": "string", "minLength": 1 },
    "authorityPolicySnapshotId": { "type": "string", "minLength": 1 },
    "sourcePolicySnapshotId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["VERIFIED", "CONTRADICTED", "UNKNOWN"] },
    "resolvedValue": {},
    "verificationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectRef", "effectiveWindow", "claimType"],
      "properties": {
        "subjectRef": { "type": "string", "minLength": 1 },
        "effectiveWindow": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": ["string", "null"], "format": "date-time" },
                "end": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          ]
        },
        "claimType": { "type": "string", "minLength": 1 }
      }
    },
    "sourceLookupPath": { "enum": ["REGISTRY_HIT", "REGISTRY_REFRESH", "GENERIC_DISCOVERY"] },
    "sourceLookupTrace": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lookupStep" } },
    "sourceRegistryRefs": { "type": "array", "items": { "type": "string" } },
    "primarySourceRefs": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "sourceFeedback": { "type": "array", "items": { "$ref": "#/$defs/sourceFeedback" } },
    "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "lookupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepIndex", "stepType", "sourceRef", "sourceRegistryRef", "outcome", "reasonCode"],
      "properties": {
        "stepIndex": { "type": "integer", "minimum": 0 },
        "stepType": { "enum": ["REGISTRY_LOOKUP", "CACHE_LOOKUP", "OFFICIAL_FETCH", "GENERIC_DISCOVERY", "FEE_LOOKUP"] },
        "sourceRef": { "type": ["string", "null"] },
        "sourceRegistryRef": { "type": ["string", "null"] },
        "outcome": { "enum": ["HIT", "MISS", "SUCCESS", "STALE", "DEAD", "SCOPE_MISMATCH", "ERROR", "SKIPPED"] },
        "reasonCode": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceRef", "sourceRegistryRef", "sourceTier", "sourceRole", "claimType", "authorityScore", "authorityClass", "retrievedAt", "effectiveFrom", "effectiveUntil", "freshnessStatus", "supports"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceRegistryRef": { "type": ["string", "null"] },
        "sourceTier": { "type": "integer", "minimum": 1, "maximum": 4 },
        "sourceRole": { "enum": ["AUTHORITATIVE", "CORROBORATING", "DISCOVERY_ONLY"] },
        "claimType": { "type": "string", "minLength": 1 },
        "authorityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "authorityClass": { "enum": ["A", "B", "C", "D", "E"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "effectiveFrom": { "type": ["string", "null"], "format": "date-time" },
        "effectiveUntil": { "type": ["string", "null"], "format": "date-time" },
        "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
        "supports": { "enum": ["SUPPORTS", "CONTRADICTS", "PARTIAL", "NOT_RELEVANT"] }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflictId", "evidenceRefs", "resolutionStatus", "reasonCode"],
      "properties": {
        "conflictId": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "resolutionStatus": { "enum": ["RESOLVED", "UNRESOLVED"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "winningEvidenceRef": { "type": ["string", "null"] }
      }
    },
    "sourceFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceRegistryRef", "healthSignal", "reasonCode"],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceRegistryRef": { "type": ["string", "null"] },
        "healthSignal": { "enum": ["HEALTHY", "DEGRADED", "DEAD", "REPLACED", "SCOPE_MISMATCH", "NEW_SOURCE_DISCOVERED"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "replacementSourceRef": { "type": ["string", "null"] }
      }
    }
  }
}
