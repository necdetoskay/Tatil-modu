{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/food-local-taste-result.v1.json",
  "title": "FoodAndLocalTasteResult.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "locationContextRef", "localTasteBriefs", "foodCandidates", "rejectedCandidates", "warnings", "overallConfidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "locationContextRef": { "type": "string", "minLength": 1 },
    "journeySegmentRef": { "type": ["string", "null"] },
    "localTasteBriefs": { "type": "array", "items": { "$ref": "#/$defs/localTasteBrief" } },
    "foodCandidates": { "type": "array", "items": { "$ref": "#/$defs/foodCandidate" } },
    "rejectedCandidates": { "type": "array", "items": { "$ref": "#/$defs/foodCandidate" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "localTasteBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localTasteId", "name", "category", "regionRefs", "knowledgeStatus", "volatilityClass", "evidence"],
      "properties": {
        "localTasteId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["dish", "dessert", "beverage", "ingredient", "tradition", "product"] },
        "regionRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "description": { "type": ["string", "null"] },
        "knowledgeStatus": { "enum": ["VERIFIED", "PARTIAL", "DISCOVERY_ONLY"] },
        "volatilityClass": { "enum": ["V0", "V1"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "foodCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foodId", "providerIds", "name", "location", "categories", "businessStatus", "openingHours", "menuEvidence", "priceFact", "eligibility", "familyFit", "aggregateSignals", "reviewAnalysisRef", "evidence", "unresolvedClaims", "confidence"],
      "properties": {
        "foodId": { "type": "string", "minLength": 1 },
        "providerIds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "id"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "name": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "formattedAddress", "evidenceRefs"],
          "properties": {
            "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
            "formattedAddress": { "type": ["string", "null"] },
            "evidenceRefs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "localTasteRefs": { "type": "array", "items": { "type": "string" } },
        "businessStatus": { "$ref": "#/$defs/statusFact" },
        "openingHours": { "$ref": "#/$defs/openingHoursFact" },
        "menuEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "items", "dietarySignals", "evidenceRefs"],
          "properties": {
            "status": { "enum": ["SUPPORTED_CURRENT", "SUPPORTED_OFFICIAL_UNDATED", "PARTIAL", "CONFLICTING", "UNKNOWN"] },
            "items": { "type": "array", "items": { "type": "string" } },
            "dietarySignals": { "type": "array", "items": { "type": "string" } },
            "evidenceRefs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "priceFact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "amount", "currency", "priceLevel", "evidenceRefs"],
          "properties": {
            "status": { "enum": ["LIVE", "OFFICIAL", "ESTIMATED", "UNKNOWN"] },
            "amount": { "type": ["number", "null"], "minimum": 0 },
            "currency": { "type": ["string", "null"] },
            "priceLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
            "evidenceRefs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "dispositionReasons", "hardConstraintChecks"],
          "properties": {
            "disposition": { "enum": ["ACCEPTED", "REJECTED", "NEEDS_VERIFICATION"] },
            "dispositionReasons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "evidenceRefs"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "constraintId": { "type": ["string", "null"] },
                  "evidenceRefs": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "hardConstraintChecks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["constraintId", "status", "evidenceRefs"],
                "properties": {
                  "constraintId": { "type": "string", "minLength": 1 },
                  "status": { "enum": ["SATISFIED", "VIOLATED", "UNVERIFIED", "NOT_APPLICABLE"] },
                  "evidenceRefs": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "familyFit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["band", "mealWindowFit", "expectedMealBurden", "reasonCodes"],
          "properties": {
            "band": { "enum": ["EXCELLENT", "GOOD", "CONDITIONAL", "WEAK", "UNKNOWN"] },
            "mealWindowFit": { "enum": ["GOOD", "CONDITIONAL", "WEAK", "UNKNOWN"] },
            "expectedMealBurden": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
            "reasonCodes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "aggregateSignals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rating", "userRatingCount"],
          "properties": {
            "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
            "userRatingCount": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "reviewAnalysisRef": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "unresolvedClaims": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "statusFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidenceRefs"],
      "properties": {
        "value": { "enum": ["OPERATIONAL", "CLOSED_TEMPORARILY", "CLOSED_PERMANENTLY", "UNKNOWN"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "openingHoursFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dataType", "value", "evidenceRefs"],
      "properties": {
        "status": { "enum": ["SUPPORTED", "PARTIAL", "CONFLICTING", "STALE", "UNKNOWN"] },
        "dataType": { "enum": ["CURRENT", "REGULAR", "OFFICIAL_SCHEDULE", "NONE"] },
        "value": { "type": ["object", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "claimType", "sourceTier", "sourceRef", "retrievedAt", "freshnessStatus"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "claimType": { "type": "string", "minLength": 1 },
        "sourceTier": { "type": "integer", "minimum": 1, "maximum": 4 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "freshnessStatus": { "enum": ["CURRENT", "STALE", "UNKNOWN"] }
      }
    }
  }
}
