{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatil-modu.local/schemas/travel-intelligence/intelligence-assessment.schema.json",
  "title": "Travel Intelligence Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentId",
    "module",
    "entityId",
    "tripContextId",
    "status",
    "dimensions",
    "risks",
    "opportunities",
    "recommendationSignals",
    "confidence",
    "explanation",
    "claimRefs",
    "observationRefs",
    "evidenceRefs",
    "policyVersion"
  ],
  "properties": {
    "assessmentId": {
      "type": "string"
    },
    "module": {
      "type": "object",
      "required": [
        "moduleId",
        "version"
      ],
      "properties": {
        "moduleId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "tripContextId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "insufficient",
        "blocked"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommendationSignals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "explanation": {
      "type": "object"
    },
    "claimRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observationRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyVersion": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
