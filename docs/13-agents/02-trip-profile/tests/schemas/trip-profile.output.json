{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TripProfile",
  "description": "Trip Profile Agent'ın çıktısı — diğer tüm agentların girdi kontratıdır",
  "type": "object",
  "required": [
    "profileId",
    "tripPurpose",
    "temporal",
    "travelers",
    "budget",
    "vehicle",
    "accommodationPreference",
    "accessibilityNeeds",
    "childCareNeeds",
    "petFriendly",
    "riskTolerance",
    "confidence",
    "source",
    "conflictFlags"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "description": "UUID veya session-scoped ID"
    },
    "tripPurpose": {
      "type": "string",
      "enum": ["relaxation", "exploration", "adventure", "family", "romantic", "culture", "wellness"]
    },
    "temporal": {
      "type": "object",
      "required": ["flexibility", "startDate", "endDate", "durationDays"],
      "properties": {
        "flexibility": {
          "type": "string",
          "enum": ["fixed", "flexible_3days", "flexible_7days", "month"]
        },
        "startDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "endDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "durationDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "seasonPreference": {
          "type": "string",
          "enum": ["summer", "winter", "spring", "autumn", "any"]
        }
      },
      "additionalProperties": false
    },
    "travelers": {
      "type": "object",
      "required": ["adults", "children", "elderlyCount"],
      "properties": {
        "adults": { "type": "integer", "minimum": 1, "maximum": 10 },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["age"],
            "properties": {
              "age": { "type": "integer", "minimum": 0, "maximum": 17 },
              "ageBand": {
                "type": "string",
                "enum": ["baby", "preschooler", "elementary", "middle_school"]
              },
              "specialNeeds": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "elderlyCount": { "type": "integer", "minimum": 0, "maximum": 5 },
        "accessibilityRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["totalTRY", "perPersonPerNightTRY", "currency", "budgetFlexibility"],
      "properties": {
        "totalTRY": { "type": "number", "minimum": 0 },
        "perPersonPerNightTRY": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "enum": ["TRY"] },
        "budgetFlexibility": { "type": "string", "enum": ["strict", "moderate", "flexible"] }
      },
      "additionalProperties": false
    },
    "vehicle": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["private_car", "public_transport", "walking", "electric_vehicle", "rental_car"]
        },
        "hasDriver": { "type": "boolean" },
        "drivingRangeKm": { "type": ["integer", "null"], "minimum": 0, "maximum": 2000 },
        "chargingNeeded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "accommodationPreference": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["hotel", "apartment", "villa", "hostel", "boutique", "resort", "camping", "any"]
        },
        "minStarRating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "breakfastIncluded": { "type": "boolean" },
        "pool": { "type": "boolean" },
        "parking": { "type": "boolean" },
        "kidClub": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "accessibilityNeeds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "childCareNeeds": { "type": "boolean" },
    "petFriendly": { "type": "boolean" },
    "riskTolerance": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "specialRequests": { "type": "array", "items": { "type": "string" } },
    "confidence": {
      "type": "object",
      "required": ["score", "completeness", "missingFields", "uncertainFields"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingFields": { "type": "array", "items": { "type": "string" } },
        "uncertainFields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["method", "timestamp"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["user_input", "profile_update", "revision"]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "originalInput": { "type": "string" }
      },
      "additionalProperties": false
    },
    "conflictFlags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
